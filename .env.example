# Ports
STATIONEERS_GAME_PORT=27016
STATIONEERS_QUERY_PORT=27015

# Command-line arguments passed to rocketstation_DedicatedServer
# Default: create a fresh Mars world named MarsBase and log to /data/server.log.
STATIONEERS_ARGS=-file start MarsBase Mars -logFile "/data/server.log" -settings StartLocalHost true ServerVisible true GamePort 27016 UpdatePort 27015 ServerName "MyStationeersServer" ServerPassword "" ServerMaxPlayers 6 AutoSave true SaveInterval 300 UseSteamP2P false

# SteamCMD branch
STATIONEERS_APP_ID=600760
STATIONEERS_BRANCH=public
# STATIONEERS_BETAPASS=

# Steam credentials (build-time) — required; set to an account that owns Stationeers.
# If you want to try anonymous, set STEAM_LOGIN=anonymous and leave password empty,
# but some environments fail with "Missing configuration" unless a real account is used.
STEAM_LOGIN=
STEAM_PASSWORD=
STEAM_GUARD_CODE=
