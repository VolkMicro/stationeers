# Ports
STATIONEERS_GAME_PORT=27016
STATIONEERS_QUERY_PORT=27015

# Command-line arguments passed to rocketstation_DedicatedServer
# Default: create a fresh Mars world (Normal, DefaultStart, spawn MarsSpawnCanyonOverlook) named MarsBase and log to /data/server.log.
STATIONEERS_ARGS=-file start MarsBase Mars2 Normal DefaultStart MarsSpawnCanyonOverlook -logFile "/data/server.log" -settings StartLocalHost true ServerVisible true GamePort 27016 UpdatePort 27015 ServerName "MyStationeersServer" ServerPassword "" ServerMaxPlayers 6 AutoSave true SaveInterval 300 UseSteamP2P false

# SteamCMD branch
STATIONEERS_APP_ID=600760
STATIONEERS_BRANCH=public
# STATIONEERS_BETAPASS=

# Steam credentials (build-time). Default is anonymous; set a real account only if needed.
STEAM_LOGIN=anonymous
STEAM_PASSWORD=
STEAM_GUARD_CODE=

# Force platform for SteamCMD (leave empty normally). Example: windows
STEAMCMD_FORCE_PLATFORM=
