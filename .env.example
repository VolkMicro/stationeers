# Порты на хосте
STATIONEERS_GAME_PORT=27016
STATIONEERS_QUERY_PORT=27015

# Аргументы запуска (пример: загружаем/создаём сейв "Luna" на Луне)
# Используйте ваш реальный worldname, чтобы подхватить существующий сейв без миграций
STATIONEERS_ARGS=-file start Luna Lunar -logFile "./server.log" -settings StartLocalHost true ServerVisible true GamePort 27016 UpdatePort 27015 ServerName "MyStationeersServer" ServerPassword "" ServerMaxPlayers 6 AutoSave true SaveInterval 300 UseSteamP2P false

# Ветка SteamCMD
STATIONEERS_BRANCH=public
# STATIONEERS_BETAPASS=  # если нужна приватная beta

# Бэкапы
BACKUP_CRON=*/30 * * * *
BACKUP_KEEP_DAYS=14
